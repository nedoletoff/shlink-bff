# .env.example — скопируйте в .env и заполните значения
# cp .env.example .env && vi .env
#
# Переменные сгруппированы по сервисам docker-compose.yml.

# -- Домены ----------------------------------------------
# Публичный домен редиректора коротких ссылок
DOMAIN_SHORT=shlink.example.com
# Защищённый домен веб-интерфейса управления
DOMAIN_SHORT_CREATE=shlink-create.example.com

# -- PostgreSQL (сервис bff-postgres) --------------------
DB_USER=bff
DB_PASSWORD=change_me_db_password
# Имя базы данных (используется и postgres-контейнером, и Go-бэкендом)
DB_NAME=shlink_bff
# При необходимости можно переопределить хост/порт (по умолчанию: postgres:5432)
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSLMODE=disable
#
# Альтернатива: задать DATABASE_URL целиком (имеет приоритет над DB_* переменными)
# DATABASE_URL=postgres://bff:password@postgres:5432/shlink_bff?sslmode=disable

# -- Shlink API ------------------------------------------
# Начальный admin API key (только для shlink-api при первом старте).
# unified-backend использует per-user ключи из БД, не этот.
ADMIN_SHLINK_API_KEY=change_me_admin_api_key

# -- unified-backend (Go) --------------------------------
# Маппинг Keycloak-групп на имена ролей (формат: group=role,...)
ROLE_GROUPS=shlink-admin=shlink-admin,shlink-user=shlink-user
# Имя роли с доступом к /api/admin/*. Должно совпадать с одним из role-name в ROLE_GROUPS.
ADMIN_ROLE=shlink-admin
# Устарело: используйте ROLE_GROUPS вместо ADMIN_GROUPS
# ADMIN_GROUPS=shlink-admins,admin

# -- Фич-флаги -------------------------------------------
FEATURE_USER_SLUG_PREFIX=false
FEATURE_USER_TAG_INTERNAL_ID=false

# -- Keycloak --------------------------------------------
KEYCLOAK_HOST=keycloak.example.com
KEYCLOAK_IP=192.168.1.100

# -- oauth2-proxy ----------------------------------------
OAUTH2_CLIENT_SECRET_SHLINK=change_me_client_secret
OAUTH2_COOKIE_SECRET=change_me_cookie_secret_32bytes
