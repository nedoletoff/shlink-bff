# .env.example — скопируйте в .env и заполните значения
# cp .env.example .env && vi .env
#
# Переменные сгруппированы по сервисам docker-compose.yml.
# Список синхронизирован с docker-compose.yml и unified-backend/internal/config.

# -- Домены ----------------------------------------------
# Публичный домен редиректора коротких ссылок (shlink-api + nginx vhost shlink.example.com)
DOMAIN_SHORT=shlink.example.com
# Защищённый домен веб-интерфейса управления (nginx vhost shlink-create.example.com)
DOMAIN_SHORT_CREATE=shlink-create.example.com

# -- PostgreSQL (для Go-бэкенда, сервис bff-postgres) -------
DB_USER=bff
DB_PASSWORD=change_me_db_password

# -- Shlink API ------------------------------------------
# Начальный admin API key для shlink-api (INITIAL_API_KEY, создаётся при первом старте).
# ВНИМАНИЕ: unified-backend НЕ использует этот ключ — он работает с per-user ключами из БД.
# Этот ключ нужен только самому shlink-api для первичной загрузки.
ADMIN_SHLINK_API_KEY=change_me_admin_api_key

# -- unified-backend (Go) --------------------------------
# Маппинг Keycloak-групп на имена ролей (comma-separated, формат: group=role).
# Пример: shlink-admin=shlink-admin,shlink-user=shlink-user
# Если не задано — используется дефолт: shlink-admins=admin,admin=admin
#
# Группы Keycloak → роли в БД и /api/me:
ROLE_GROUPS=shlink-admin=shlink-admin,shlink-user=shlink-user
#
# Имя роли, считающейся администратором (доступ к /api/admin/*).
# Должно совпадать с одним из role-name в ROLE_GROUPS.
# По умолчанию: admin
ADMIN_ROLE=shlink-admin
#
# Устарело: используйте ROLE_GROUPS вместо ADMIN_GROUPS.
# ADMIN_GROUPS=shlink-admins,admin
#
# Прочие переменные backend задаются в docker-compose.yml напрямую:
#   HTTP_ADDR            — адрес прослушивания (по умолчанию :8080)
#   DATABASE_URL         — DSN PostgreSQL (собирается из DB_USER/DB_PASSWORD)
#   SHLINK_INTERNAL_URL  — внутренний URL shlink-api (http://shlink-api:8080)

# -- Keycloak --------------------------------------------
# FQDN Keycloak (если недоступен через DNS, oauth2-proxy резолвит через extra_hosts)
KEYCLOAK_HOST=keycloak.example.com
KEYCLOAK_IP=192.168.1.100

# -- oauth2-proxy ----------------------------------------
# Client secret из Keycloak → Clients → shlink-bff → Credentials
OAUTH2_CLIENT_SECRET_SHLINK=change_me_client_secret
# Случайная строка 32 байта: openssl rand -base64 32
OAUTH2_COOKIE_SECRET=change_me_cookie_secret_32bytes

# -- Фич-флаги unified-backend -------------------------
# Добавлять префикс пользователя к слагу URL (включает изоляцию ссылок по владельцу)
FEATURE_USER_SLUG_PREFIX=false
# Использовать внутренний ID тега вместо публичного имени
FEATURE_USER_TAG_INTERNAL_ID=false
