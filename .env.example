# HTTP
HTTP_ADDR=:8080

# Database – либо полный URL:
DATABASE_URL=postgres://user:pass@localhost:5432/unified?sslmode=disable
# Или отдельные компоненты:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=unified
DB_SSLMODE=disable

# Shlink
SHLINK_INTERNAL_URL=http://shlink:8080
SHLINK_DEFAULT_DOMAIN=short.example.com
SHLINK_ADMIN_API_KEY=your_admin_api_key

# CORS
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With

# Auth (Keycloak / OAuth2-Proxy)
TRUSTED_HEADER_SECRET=your_hmac_secret
DEFAULT_ROLE=viewer
ADMIN_ROLE=admin
ROLE_SOURCE=keycloak   # или db
ROLE_GROUPS=shlink-admins=admin,analysts=viewer

# Features
FEATURE_USER_SLUG_PREFIX=false
FEATURE_USER_TAG_INTERNAL_ID=false
FEATURE_USER_CUSTOM_SLUG=true

# Shlink short code length (0 = use Shlink default)
SHLINK_SHORT_ID_LENGTH=0

# Provisioner mode: docker или native
SHLINK_RUNNER_MODE=docker
SHLINK_CONTAINER=shlink-api
SHLINK_BIN=shlink

# Default limits for new links
MAX_VISITS_DEFAULT=0
LINK_TTL_DEFAULT_DAYS=0

# Bulk operations limit
BULK_OPERATION_LIMIT=100
FEATURE_USER_CUSTOM_SLUG=true
# Длина short-кода, генерируемого Shlink (0 = использовать дефолт Shlink).
SHLINK_SHORT_ID_LENGTH=0

# -- Keycloak --------------------------------------------
KEYCLOAK_HOST=keycloak.example.com
KEYCLOAK_IP=192.168.1.100

# -- oauth2-proxy ----------------------------------------
OAUTH2_CLIENT_SECRET_SHLINK=change_me_client_secret
OAUTH2_COOKIE_SECRET=change_me_cookie_secret_32bytes
