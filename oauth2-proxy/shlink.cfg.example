# oauth2-proxy config для shlink-create.example.com
# Скопируйте в shlink.cfg и заполните значения.
# Секреты OAUTH2_CLIENT_SECRET и OAUTH2_COOKIE_SECRET задаются через env в docker-compose.yml.
# Документация: https://oauth2-proxy.github.io/oauth2-proxy/docs/configuration/overview

provider            = "oidc"
oidc_issuer_url     = "https://YOUR_KEYCLOAK_HOST/realms/YOUR_REALM"  # <-- заменить
client_id           = "shlink-bff"                                    # <-- client_id в Keycloak
client_secret       = "OAUTH2_CLIENT_SECRET"                          # задаётся через env OAUTH2_PROXY_CLIENT_SECRET

redirect_url        = "https://shlink-create.example.com/oauth2/callback"  # <-- заменить

# Слушаем на 4180
http_address        = "0.0.0.0:4180"

# Cookie настройки
# cookie_name — имя сессионной cookie. Используйте уникальное имя, если
#               несколько экземпляров oauth2-proxy работают на одном домене.
# cookie_expire — срок жизни сессии (рекомендуется не менее 1h)
# cookie_refresh — как часто обновлять токен (должен быть < cookie_expire)
# cookie_samesite = "lax" подходит для большинства случаев;
#                  используйте "none" только если oauth2-proxy и приложение
#                  на разных доменах (требует cookie_secure = true).
cookie_name         = "_shlink_session"
cookie_secret       = "OAUTH2_COOKIE_SECRET"  # задаётся через env OAUTH2_PROXY_COOKIE_SECRET
cookie_secure       = true
cookie_httponly     = true
cookie_samesite     = "lax"
cookie_expire       = "8h"
cookie_refresh      = "1h"
# session_cookie_minimal НЕ включать: при коротком access_token Keycloak
# это приводит к потере refresh_token и немедленному вылету из сессии.
# session_cookie_minimal = true  # НЕ включать

# Identity headers — oauth2-proxy добавит к каждому ответу на /oauth2/auth:
#   X-Auth-Request-User               — уникальный ID пользователя (sub)
#   X-Auth-Request-Email              — e-mail
#   X-Auth-Request-Preferred-Username — username
#   X-Auth-Request-Groups             — список групп Keycloak (через запятую)
# nginx читает эти заголовки через auth_request_set и пробрасывает в backend.
set_xauthrequest            = true
pass_access_token           = false  # токен не покидает oauth2-proxy
pass_authorization_header   = false  # Bearer не идёт в backend

# Группы из Keycloak
# oauth2-proxy возьмёт claim "groups" из OIDC-токена и поместит его
# в заголовок X-Auth-Request-Groups.
# Для этого в Keycloak необходимо настроить mapper:
#   Client → Mappers → Add mapper → Group Membership
#   Token Claim Name = groups
oidc_groups_claim           = "groups"

# Разрешённые email-домены (раскомментировать если нужно)
# email_domains = ["example.com"]

# Logging
request_logging   = true
auth_logging      = true
standard_logging  = true

# Trusted reverse proxy (nginx — доверяем внутренней сети)
# Укажите CIDR вашей docker-сети или диапазон IP вашего nginx.
trusted_ips_config = "172.0.0.0/8,10.0.0.0/8,192.168.0.0/16"

# Пропускаем auth для healthcheck
skip_auth_routes = ["^/healthz$"]

# Сессия хранится целиком в cookie (без Redis).
# Для production с большим числом пользователей рекомендуется Redis.
session_store_type = "cookie"
